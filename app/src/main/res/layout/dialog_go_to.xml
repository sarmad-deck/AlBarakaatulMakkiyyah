<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/go_to_title"
            android:textColor="#303F9F"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/by_page"
            android:textColor="#424242"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/go_to_page_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:backgroundTint="#00897B"
                android:hint="@string/go_to_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLines="1"
                android:textColor="#212121"
                android:textSize="16sp" />

            <Button
                android:id="@+id/go_to_page_button"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_goto_button"
                android:text="@string/go_to_action"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/by_manzil"
            android:textColor="#424242"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/manzil_1"
                style="@style/GotoChip"
                android:tag="121"
                android:text="@string/manzil_1" />

            <Button
                android:id="@+id/manzil_2"
                style="@style/GotoChip"
                android:tag="142"
                android:text="@string/manzil_2" />

            <Button
                android:id="@+id/manzil_3"
                style="@style/GotoChip"
                android:tag="162"
                android:text="@string/manzil_3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/manzil_4"
                style="@style/GotoChip"
                android:tag="184"
                android:text="@string/manzil_4" />

            <Button
                android:id="@+id/manzil_5"
                style="@style/GotoChip"
                android:tag="209"
                android:text="@string/manzil_5" />

            <Button
                android:id="@+id/manzil_6"
                style="@style/GotoChip"
                android:tag="229"
                android:text="@string/manzil_6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/manzil_7"
                style="@style/GotoChip"
                android:tag="248"
                android:text="@string/manzil_7" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/by_sulas"
            android:textColor="#424242"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/sulas_1"
                style="@style/GotoChip"
                android:tag="121"
                android:text="@string/sulas_1" />

            <Button
                android:id="@+id/sulas_2"
                style="@style/GotoChip"
                android:tag="168"
                android:text="@string/sulas_2" />

            <Button
                android:id="@+id/sulas_3"
                style="@style/GotoChip"
                android:tag="220"
                android:text="@string/sulas_3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/all_in_one"
                android:textColor="#424242"
                android:textSize="18sp" />

            <Button
                android:id="@+id/all_in_one"
                style="@style/GotoChip"
                android:layout_width="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_weight="0"
                android:tag="121"
                android:text="@string/all_in_one" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
